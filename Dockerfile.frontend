FROM node:22-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM node:22-slim AS runner
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV RECORDINGS_STORAGE_PATH=/app/data/recordings
ENV MAX_RECORDING_SIZE_MB=500
COPY --from=builder /app ./
RUN mkdir -p /app/data/recordings /app/data/chunks
EXPOSE 3000
CMD ["npm", "run", "dev"]
