# MeetMind AI Environment Variables

# Active Web Server & Frontend
PORT=3000
NODE_ENV=production
# Leave VITE_API_URL unset for same-origin (/api/v1) in production, or set your public HTTPS API origin
VITE_API_URL=/api/v1
VITE_SIGNALR_URL=
GEMINI_API_KEY=

# ASP.NET Core 8 Backend
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=
JWT_SECRET=
AI_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=https://meetmind-atlas.ai.studio,https://project-graduation.ai.studio,http://localhost:3000
# Optional comma-separated additional Vite allowed hostnames
VITE_ALLOWED_HOSTS=

# Python FastAPI AI Service
PYTHON_ENV=production
WHISPER_MODEL=base
OPENAI_API_KEY=

# Authentication & Google Sign-In (OAuth 2.0 / OIDC)
# Create a Web Application OAuth Client ID in Google Cloud Console
# Add https://meetmind-atlas.ai.studio and http://localhost:3000 to Authorized JavaScript origins
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Public application origin (e.g., https://meetmind-atlas.ai.studio)
PUBLIC_APP_URL=https://meetmind-atlas.ai.studio

# Storage & Media Pipeline Limits
MEETMIND_DATA_DIR=/app/data
RECORDINGS_STORAGE_PATH=/app/data/recordings
CHUNKS_STORAGE_PATH=/app/data/chunks
MAX_RECORDING_SIZE_MB=500
