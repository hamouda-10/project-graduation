# MeetMind AI Environment Configuration Reference

# Frontend Configuration
PORT=3000
NODE_ENV=production
VITE_API_URL=http://localhost:3000/api/v1

# ASP.NET Core Backend
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=MeetMindDb;User Id=sa;Password=Your_password123!;TrustServerCertificate=True;
JWT_SECRET=your-enterprise-jwt-signing-secret-minimum-256-bits-long
AI_SERVICE_URL=http://localhost:8000

# Python AI Service
PYTHON_ENV=production
WHISPER_MODEL=base
OPENAI_API_KEY=your-optional-openai-key-if-cloud-enabled

# Storage & Processing
RECORDINGS_STORAGE_PATH=./data/recordings
MAX_RECORDING_SIZE_MB=500
